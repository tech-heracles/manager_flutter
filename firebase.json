{
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/index.html",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "source": "/flutter_bootstrap.js",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "source": "/flutter_service_worker.js",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "source": "/main.dart.js",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "source": "/version.json",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            }
        ]
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "poss-66570",
                    "appId": "1:580976539578:android:7c45d5c8e1299af8644f83",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "poss-66570",
                    "configurations": {
                        "android": "1:580976539578:android:7c45d5c8e1299af8644f83",
                        "web": "1:580976539578:web:8a2e8baa717c72c2644f83",
                        "windows": "1:580976539578:web:8e1401be7f011847644f83"
                    }
                }
            }
        }
    }
}